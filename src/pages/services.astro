---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Services">
  <div class="max-w-7xl mx-auto px-4 py-12 sm:py-20">
    <div class="mb-16">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Services</h1>
      <p class="text-lg text-gray-600">
        Professional web performance optimization services.
      </p>
    </div>

    <!-- Services Gallery -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map(service => (
        <a href={`/services/${service.id.replace(/\.[^/.]+$/, "")}`} class="group bg-white border border-gray-100 rounded-2xl overflow-hidden hover:shadow-lg transition-all block">
          {service.data.cover && (
            <div class="h-56 overflow-hidden bg-gray-100">
               <Image
                src={service.data.cover}
                alt={service.data.title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                quality={80}
                format="webp"
                width={600}
              />
            </div>
          )}
          <div class="p-6">
            <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">{service.data.title}</h3>
            <p class="text-gray-600 text-sm line-clamp-3">{service.data.description}</p>
          </div>
        </a>
      ))}
      {services.length === 0 && (
         <div class="col-span-full text-center py-12 bg-gray-50 rounded-xl">
            <p class="text-gray-500">No services added yet.</p>
         </div>
      )}
    </div>
  </div>
</Layout>
