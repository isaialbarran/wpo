const iconPath = icons[name] || icons['sparkles'];
---

<svg
  class={className}
  style={sizeStyle}
  fill="none"
  stroke="currentColor"
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  set:html={iconPath}
/>
